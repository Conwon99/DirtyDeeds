---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdHeader } from "@/sections/Header/components/AdHeader";
import { TrackedTelLink } from "@/components/TrackedTelLink";
import { CTASection } from "@/sections/Footer/components/CTASection";
import { FAQItem } from "@/pages/contact/sections/FAQSection/components/FAQItem";
import { getCategoryBySlug, getServicesForCategory } from "@/data/categories";
import { getServiceBySlug } from "@/data/services";
import { reviews, TOTAL_REVIEW_COUNT } from "@/data/reviews";
import { locations } from "@/data/locations";
import { absoluteUrl, brandName, citiesLabel } from "@/data/business";

const category = getCategoryBySlug("roof-cleaning-ayrshire")!;
const includedServices = getServicesForCategory(category);
const roofService = getServiceBySlug("roof-cleaning-moss-removal")!;
const canonical = absoluteUrl("/ads/roof-cleaning-ayrshire");
const absoluteImage = absoluteUrl(category.image);

const whyChooseUsPoints = [
  "Free, no-obligation quotes — no pressure, no obligation",
  "Safe scrape-and-biocide method — no harsh pressure washing on tiles",
  "Fully insured, experienced local team",
  "Gutter clearing & fascia cleaning available on the same visit",
  "Biocide treatment to help prevent moss and algae regrowth",
  `Local specialist covering ${citiesLabel()} and surrounding towns`,
];

const howItWorksSteps = [
  {
    step: "1",
    title: "Contact Us",
    description: "Call or message us with your roof cleaning needs. We'll answer your questions and get you booked in.",
  },
  {
    step: "2",
    title: "Get Your Free Quote",
    description: "We assess your roof's condition and access, then provide a free, no-obligation quote — honest advice, no pushy sales.",
  },
  {
    step: "3",
    title: "We Get To Work",
    description: "Safe manual moss removal, biocide treatment and gutter clearing — leaving your roof clean, treated and looking its best.",
  },
];
---

<BaseLayout
  title={`Roof Cleaning & Moss Removal in ${citiesLabel()} | ${brandName()}`}
  description={category.description}
  canonical={canonical}
  ogImage={absoluteImage}
  robots="noindex, follow"
>
  <div class="text-neutral-600 text-lg not-italic normal-nums font-medium accent-auto bg-[#111111] box-border caret-transparent block tracking-[normal] leading-[27px] list-outside list-disc min-h-full pointer-events-auto text-start indent-[0px] normal-case visible border-separate font-manrope">
    <AdHeader client:load />
    <main>
      <!-- Hero -->
      <section class="box-border caret-transparent pt-[88px] md:pt-[112px]">
        <div class="relative bg-gray-900 bg-cover bg-center box-border caret-transparent mx-[15px] pt-[70px] pb-[60px] rounded-[20px] md:pt-[110px] md:pb-[80px] overflow-hidden" style={`background-image:url('${category.image}')`}>
          <div class="absolute inset-0 bg-gradient-to-b from-gray-900/60 via-gray-900/75 to-gray-900/95"></div>
          <div class="relative z-10 box-border caret-transparent max-w-[820px] mx-auto px-[15px] md:px-[30px] text-center">
            <p class="text-[#ea580c] text-sm font-semibold uppercase tracking-[0.18em] mb-4">Roof Cleaning</p>
            <h1 class="text-white text-[32px] font-bold box-border caret-transparent leading-[40px] mb-4 md:text-[58px] md:leading-[66px]">
              {citiesLabel()}'s Roof Cleaning & Moss Removal Experts
            </h1>
            <p class="text-slate-200 box-border caret-transparent max-w-[620px] mx-auto mb-6">{category.description}</p>

            <div class="flex items-center justify-center gap-3 mb-6">
              <div class="h-px w-8 bg-white/30"></div>
              <p class="text-white/80 text-xs font-semibold uppercase tracking-[0.14em]">Fully Insured &middot; Free Quotes &middot; Satisfaction Guaranteed</p>
              <div class="h-px w-8 bg-white/30"></div>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
              <div class="flex items-center gap-2 bg-white/10 rounded-full px-4 py-2">
                <div class="flex items-center gap-0.5">
                  {[...Array(5)].map(() => (
                    <svg class="h-4 w-4 text-[#ea580c]" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <span class="text-white text-sm font-semibold">From {TOTAL_REVIEW_COUNT} reviews</span>
              </div>
              <div class="flex items-center gap-2 bg-white/10 rounded-full px-4 py-2">
                <svg class="h-4 w-4 text-[#ea580c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12c0 4.556-3.04 8.4-7.2 9.6a1.06 1.06 0 01-.6 0C9.04 20.4 6 16.556 6 12V6.75a.75.75 0 01.55-.72l5.25-1.5a.75.75 0 01.4 0l5.25 1.5a.75.75 0 01.55.72V12z" />
                </svg>
                <span class="text-white text-sm font-semibold">Fully Insured</span>
              </div>
            </div>

            <div class="box-border caret-transparent flex flex-wrap items-center justify-center gap-4">
              <TrackedTelLink
                client:load
                trackingLocation="ad-hero"
                className="text-white text-base bg-[#c2410c] box-border caret-transparent leading-[22px] text-center font-bold border border-[#c2410c] px-8 py-4 rounded-[50px] border-solid md:text-lg md:leading-[25.2px] md:px-[36px] md:py-5 hover:bg-[#ea580c] hover:border-[#ea580c] transition-colors inline-flex items-center justify-center gap-3"
              >
                <svg class="h-5 w-5 md:h-6 md:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
                Tap To Call Now
              </TrackedTelLink>
              <a href="/contact" class="text-white text-base box-border caret-transparent font-bold border border-white/70 px-8 py-4 rounded-[50px] hover:bg-white hover:text-[#c2410c] transition-colors">
                Message Us Instead
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Serving-area banner -->
      <section class="box-border caret-transparent pt-[60px] md:pt-[90px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <div class="bg-[#c2410c] box-border caret-transparent rounded-t-[20px] py-4 text-center">
            <h2 class="text-white text-xl font-bold md:text-2xl">Proudly Serving {citiesLabel()}</h2>
          </div>
          <div class="relative overflow-hidden" style="aspect-ratio: 16/7">
            <img src={category.image} alt={category.imageAlt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
          </div>
          <div class="bg-white box-border caret-transparent rounded-b-[20px] py-6 text-center">
            <TrackedTelLink
              client:load
              trackingLocation="ad-serving-area"
              className="text-white text-base bg-[#c2410c] box-border caret-transparent leading-[22px] text-center font-bold border border-[#c2410c] px-8 py-4 rounded-[50px] border-solid hover:bg-[#ea580c] hover:border-[#ea580c] transition-colors inline-flex items-center justify-center gap-3"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
              Tap To Call Now
            </TrackedTelLink>
          </div>
        </div>
      </section>

      <!-- Why choose us -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <div class="bg-white box-border caret-transparent rounded-[20px] p-6 md:p-10">
            <h2 class="text-gray-900 text-[26px] font-bold box-border caret-transparent leading-[34px] mb-6 md:text-[38px] md:leading-[46px] text-center">
              Why Choose {brandName()}?
            </h2>
            <ul class="text-gray-900 text-base md:text-lg box-border caret-transparent list-none pl-0 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-x-8 md:gap-y-5">
              {whyChooseUsPoints.map((point) => (
                <li class="flex items-start gap-3">
                  <div class="flex items-center justify-center w-6 h-6 md:w-7 md:h-7 rounded-full bg-[#ea580c] flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4 md:w-5 md:h-5 text-white" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span class="text-gray-700 font-medium">{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            How Our Roof Cleaning Works
          </h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {howItWorksSteps.map((item) => (
              <div class="bg-white rounded-[20px] p-6 text-center">
                <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[#ea580c] text-white text-xl font-bold">
                  {item.step}
                </div>
                <h3 class="text-gray-900 text-lg font-bold mb-2">{item.title}</h3>
                <p class="text-gray-700 text-sm">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Trust banner -->
      <section class="box-border caret-transparent pt-[60px] md:pt-[90px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <div class="bg-[#ea580c] rounded-[20px] py-5 px-6 text-center">
            <p class="text-white text-lg md:text-xl font-bold">100% Satisfaction &middot; Fully Insured &middot; Free Quotes</p>
          </div>
        </div>
      </section>

      <!-- Testimonials -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            What {citiesLabel()} Homeowners Say
          </h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {reviews.map((review) => (
              <div class="bg-white rounded-[20px] p-6">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center gap-3">
                    <div class={`flex h-9 w-9 items-center justify-center rounded-full text-white font-bold ${review.initialBg}`}>
                      {review.initial}
                    </div>
                    <div>
                      <p class="text-gray-900 font-bold text-sm">{review.name}</p>
                      <p class="text-gray-500 text-xs">{review.meta}</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-0.5">
                    {[...Array(5)].map(() => (
                      <svg class="h-3.5 w-3.5 text-[#ea580c]" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                </div>
                <p class="text-gray-700 text-sm leading-6">{review.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- What's included -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            What's Included
          </h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {includedServices.map((service) => (
              <div class="rounded-xl bg-neutral-900/75 border border-white/10 p-6 text-center">
                <img src={service.iconUrl} alt={service.iconAlt} class="mx-auto mb-4 h-10 w-10" />
                <h3 class="text-white text-lg font-bold mb-2">{service.shortTitle}</h3>
                <p class="text-slate-300 text-sm">{service.cardDescription}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Towns served -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <div class="relative overflow-hidden rounded-[20px]">
            <img src="/gal_01.jpg" alt={`${brandName()} service area across ${citiesLabel()}`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-[#111111]/80"></div>
            <div class="relative z-10 px-6 py-10 text-center md:py-14">
              <h2 class="text-white text-2xl font-bold mb-6 md:text-3xl">Proudly Serving {citiesLabel()}</h2>
              <p class="text-white text-base md:text-lg leading-8">
                {locations.map((location, index) => (
                  <>
                    {index > 0 && " · "}
                    <span class="font-semibold">{location.name}</span>
                  </>
                ))}
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ accordion -->
      <section class="box-border caret-transparent py-[70px] md:py-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            Frequently Asked Questions
          </h2>
          <div class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-10">
            {roofService.faq.map((item) => (
              <FAQItem client:load question={item.question} answer={item.answer} />
            ))}
          </div>
        </div>
      </section>

      <CTASection client:load />
    </main>
  </div>
</BaseLayout>
