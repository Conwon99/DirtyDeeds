---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdHeader } from "@/sections/Header/components/AdHeader";
import { ReviewStats } from "@/sections/ReviewsSection/components/ReviewStats";
import { ContactFormSection } from "@/pages/contact/sections/HeroSection/components/ContactFormSection";
import { FAQItem } from "@/pages/contact/sections/FAQSection/components/FAQItem";
import { getCategoryBySlug, getServicesForCategory } from "@/data/categories";
import { getServiceBySlug } from "@/data/services";
import { reviews } from "@/data/reviews";
import { locations } from "@/data/locations";
import { absoluteUrl, brandName, citiesLabel } from "@/data/business";

const category = getCategoryBySlug("roof-cleaning-ayrshire")!;
const includedServices = getServicesForCategory(category);
const roofService = getServiceBySlug("roof-cleaning-moss-removal")!;
const canonical = absoluteUrl("/ads/roof-cleaning-ayrshire");
const heroImage = "/gal_11.jpg";
const absoluteImage = absoluteUrl(heroImage);
const roofGalleryImages = ["/gal_07.jpg", "/gal_08.jpg", "/gal_09.jpg", "/gal_10.jpg"];

const heroBenefitTicks = ["Safe Method", "Fully Insured", "Free Quotes"];

// Stylised (not survey-accurate) outline of the Ayrshire coastline for the service-area map.
const ayrshireOutline = "100,20 140,15 190,30 230,50 250,90 240,130 255,170 235,210 245,250 220,290 190,330 150,360 110,380 80,360 60,320 40,280 55,240 35,200 50,160 30,120 45,80 70,40";

// Approximate relative positions within the 300x420 map viewBox — illustrative, not to scale.
const townMapPositions: Record<string, { x: number; y: number }> = {
  kilwinning: { x: 95, y: 55 },
  irvine: { x: 60, y: 90 },
  stewarton: { x: 195, y: 70 },
  troon: { x: 55, y: 140 },
  kilmarnock: { x: 170, y: 155 },
  galston: { x: 215, y: 165 },
  prestwick: { x: 62, y: 190 },
  ayr: { x: 75, y: 230 },
  mauchline: { x: 180, y: 235 },
  rankinston: { x: 140, y: 265 },
  cumnock: { x: 210, y: 285 },
  maybole: { x: 95, y: 305 },
};
const townMapPoints = locations
  .filter((location) => townMapPositions[location.slug])
  .map((location) => ({ name: location.name, ...townMapPositions[location.slug] }));

// Icon shapes sourced verbatim from lucide-react (node_modules/lucide-react/dist/esm/icons) for accuracy.
const whyChooseUsPoints = [
  {
    text: "Over 22 5 Star Reviews",
    icon: [
      { tag: "polygon", points: "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2", fill: "currentColor" },
    ],
  },
  {
    text: "Locally Trusted",
    icon: [
      { tag: "path", d: "M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" },
      { tag: "circle", cx: "12", cy: "10", r: "3" },
    ],
  },
  {
    text: "Fully Insured",
    icon: [
      { tag: "path", d: "M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" },
      { tag: "path", d: "m9 12 2 2 4-4" },
    ],
  },
  {
    text: "Safe Techniques Used",
    icon: [
      { tag: "path", d: "M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" },
      { tag: "path", d: "M20 3v4" },
      { tag: "path", d: "M22 5h-4" },
      { tag: "path", d: "M4 17v2" },
      { tag: "path", d: "M5 18H3" },
    ],
  },
  {
    text: "Free Quotes",
    icon: [
      { tag: "path", d: "M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" },
      { tag: "circle", cx: "7.5", cy: "7.5", r: ".5", fill: "currentColor" },
    ],
  },
];

const howItWorksSteps = [
  {
    step: "1",
    title: "Contact Us",
    description: "Call or message us with your roof cleaning needs. We'll answer your questions and get you booked in.",
    icon: [
      { tag: "path", d: "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" },
    ],
  },
  {
    step: "2",
    title: "Get Your Free Quote",
    description: "We assess your roof's condition and access, then provide a free, no-obligation quote — honest advice, no pushy sales.",
    icon: [
      { tag: "rect", x: "8", y: "2", width: "8", height: "4", rx: "1", ry: "1" },
      { tag: "path", d: "M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" },
      { tag: "path", d: "m9 14 2 2 4-4" },
    ],
  },
  {
    step: "3",
    title: "We Get To Work",
    description: "Safe manual moss removal, biocide treatment and gutter clearing — leaving your roof clean, treated and looking its best.",
    icon: [
      { tag: "path", d: "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" },
    ],
  },
];
---

<BaseLayout
  title={`Roof Cleaning & Moss Removal in ${citiesLabel()} | ${brandName()}`}
  description={category.description}
  canonical={canonical}
  ogImage={absoluteImage}
  robots="noindex, follow"
  stickyContactHref="#quote-form"
>
  <div class="text-neutral-600 text-lg not-italic normal-nums font-medium accent-auto bg-[#111111] box-border caret-transparent block tracking-[normal] leading-[27px] list-outside list-disc min-h-full pointer-events-auto text-start indent-[0px] normal-case visible border-separate font-manrope">
    <AdHeader client:load />
    <main>
      <!-- Hero -->
      <section class="box-border caret-transparent pt-[96px] md:pt-[120px]">
        <div class="relative bg-gray-900 bg-cover bg-center box-border caret-transparent mx-[15px] pt-[80px] pb-[90px] rounded-[20px] md:pt-[140px] md:pb-[170px] overflow-hidden" style={`background-image:url('${heroImage}')`}>
          <div class="absolute inset-0 bg-gradient-to-b from-gray-900/60 via-gray-900/70 to-gray-900/90"></div>
          <div class="relative z-10 box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px] text-center">
            <p class="text-[#ea580c] text-sm font-semibold uppercase tracking-[0.18em] mb-4">Roof Cleaning</p>
            <h1 class="text-white text-[34px] font-bold box-border caret-transparent leading-[44px] mb-5 md:text-[60px] md:leading-[70px]">
              Roof Cleaning & Moss Removal in <span class="text-[#ea580c]">{citiesLabel()}</span>
            </h1>
            <p class="text-slate-200 box-border caret-transparent max-w-[640px] mx-auto mb-6">Over 10+ years of 5 star service</p>
            <div class="flex flex-nowrap items-center justify-center gap-x-3 sm:gap-x-6 mb-8">
              {heroBenefitTicks.map((tick) => (
                <div class="flex items-center gap-1.5 sm:gap-2">
                  <div class="flex items-center justify-center w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-[#ea580c] flex-shrink-0">
                    <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-white" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span class="text-white text-xs sm:text-sm md:text-base font-semibold whitespace-nowrap">{tick}</span>
                </div>
              ))}
            </div>
            <div class="box-border caret-transparent flex flex-wrap items-center justify-center gap-4 mb-8">
              <a href="#quote-form" class="text-white text-base bg-[#c2410c] box-border caret-transparent leading-[22px] text-center font-bold border border-[#c2410c] px-8 py-4 rounded-[50px] border-solid md:text-lg md:leading-[25.2px] md:px-[36px] md:py-5 hover:bg-[#ea580c] hover:border-[#ea580c] transition-colors inline-flex items-center justify-center gap-3">
                <svg class="h-5 w-5 md:h-6 md:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                Get a Free Quote
              </a>
            </div>
            <div class="flex justify-center">
              <ReviewStats client:load />
            </div>
          </div>
        </div>
      </section>

      <!-- Why choose us -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[140px]">
        <div class="box-border caret-transparent max-w-[1200px] mx-auto px-[15px] md:px-[30px]">
          <div class="box-border caret-transparent gap-x-[30px] grid auto-cols-[1fr] grid-cols-[1fr] grid-rows-[auto] gap-y-[30px] md:gap-x-[70px] md:grid-cols-[1fr_1fr] md:gap-y-[70px]">
            <div class="relative self-start box-border caret-transparent overflow-hidden rounded-[20px] w-full">
              <div class="relative w-full" style="aspect-ratio: 4/3">
                <img
                  src={heroImage}
                  alt={`${brandName()} roof cleaning technician at work on scaffolding in ${citiesLabel()}`}
                  class="absolute inset-0 h-full w-full object-cover rounded-[20px]"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="box-border caret-transparent">
              <h2 class="text-white text-3xl font-bold box-border caret-transparent leading-[38px] mb-2.5 sm:text-4xl sm:leading-[43.2px] md:text-[56px] md:leading-[67.2px]">
                Why Choose {brandName()}?
              </h2>
              <p class="text-gray-200 text-sm sm:text-base box-border caret-transparent mt-2.5 mb-5 md:mt-5 md:mb-5 leading-relaxed">
                {brandName()} helps homeowners across {citiesLabel()} with safe roof cleaning, moss removal, gutter clearing and biocide treatment — reliable service and professional results, no harsh pressure washing on tiles.
              </p>
              <div class="box-border caret-transparent mb-5 md:mb-[50px]">
                <ul class="box-border caret-transparent list-none pl-0 grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
                  {whyChooseUsPoints.map((point) => (
                    <li class="flex items-center gap-3">
                      <div class="flex items-center justify-center w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#ea580c] flex-shrink-0">
                        <svg class="w-5 h-5 md:w-6 md:h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          {point.icon.map((shape) => (
                            shape.tag === "circle" ? (
                              <circle cx={shape.cx} cy={shape.cy} r={shape.r} fill={shape.fill} />
                            ) : shape.tag === "rect" ? (
                              <rect x={shape.x} y={shape.y} width={shape.width} height={shape.height} rx={shape.rx} ry={shape.ry} />
                            ) : shape.tag === "polygon" ? (
                              <polygon points={shape.points} fill={shape.fill} />
                            ) : (
                              <path d={shape.d} />
                            )
                          ))}
                        </svg>
                      </div>
                      <span class="text-white text-lg md:text-xl font-bold">{point.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex justify-center md:justify-start">
                <a
                  href="#quote-form"
                  class="text-white text-base bg-[#c2410c] box-border caret-transparent inline-flex items-center justify-center leading-[22px] text-center font-bold border border-[#c2410c] px-8 py-4 rounded-[50px] border-solid md:text-lg md:leading-[25.2px] md:px-[36px] md:py-5 hover:bg-[#ea580c] hover:border-[#ea580c] transition-colors"
                >
                  Get a Free Quote
                </a>
              </div>
              <div class="box-border caret-transparent mt-8 md:mt-10">
                <ReviewStats client:load />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            How Our Roof Cleaning Works
          </h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {howItWorksSteps.map((item) => (
              <div class="bg-white rounded-[20px] p-6 text-center">
                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#ea580c]">
                  <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    {item.icon.map((shape) => (
                      shape.tag === "circle" ? (
                        <circle cx={shape.cx} cy={shape.cy} r={shape.r} fill={shape.fill} />
                      ) : shape.tag === "rect" ? (
                        <rect x={shape.x} y={shape.y} width={shape.width} height={shape.height} rx={shape.rx} ry={shape.ry} />
                      ) : (
                        <path d={shape.d} />
                      )
                    ))}
                  </svg>
                </div>
                <p class="text-[#ea580c] text-xs font-bold uppercase tracking-wide mb-1">Step {item.step}</p>
                <h3 class="text-gray-900 text-lg font-bold mb-2">{item.title}</h3>
                <p class="text-gray-700 text-sm">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Trust banner CTA -->
      <section class="box-border caret-transparent pt-[60px] md:pt-[90px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <a href="#quote-form" class="block bg-[#ea580c] rounded-[20px] py-5 px-6 text-center hover:bg-[#c2410c] transition-colors">
            <span class="text-white text-lg md:text-xl font-bold">100% Satisfaction &middot; Fully Insured &middot; Free Quotes</span>
          </a>
        </div>
      </section>

      <!-- Testimonials -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            What {citiesLabel()} Homeowners Say
          </h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {reviews.map((review) => (
              <div class="bg-white rounded-[20px] p-6">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center gap-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 flex-shrink-0">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                      </svg>
                    </div>
                    <div>
                      <p class="text-gray-900 font-bold text-sm">{review.name}</p>
                      <p class="text-gray-500 text-xs">{review.meta}</p>
                    </div>
                  </div>
                  <div class="flex flex-col items-end gap-1">
                    <div class="flex items-center gap-0.5">
                      {[...Array(5)].map(() => (
                        <svg class="h-3.5 w-3.5 text-[#ea580c]" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                  </div>
                </div>
                <p class="text-gray-700 text-sm leading-6">{review.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- What's included -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            What's Included
          </h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {includedServices.map((service) => (
              <div class="rounded-xl bg-neutral-900/75 border border-white/10 p-6 text-center">
                <img src={service.iconUrl} alt={service.iconAlt} class="mx-auto mb-4 h-10 w-10" />
                <h3 class="text-white text-lg font-bold mb-2">{service.shortTitle}</h3>
                <p class="text-slate-300 text-sm">{service.cardDescription}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Gallery -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            Recent Roof Cleaning Work
          </h2>
          <div class="flex overflow-x-auto snap-x snap-mandatory gap-3 -mx-[15px] px-[15px] md:grid md:grid-cols-4 md:gap-5 md:overflow-visible md:mx-0 md:px-0">
            {roofGalleryImages.map((src) => (
              <div class="relative overflow-hidden rounded-[16px] w-full shrink-0 snap-center md:w-auto md:shrink" style="aspect-ratio: 4/3">
                <img
                  src={src}
                  alt={`Roof cleaning and moss removal before and after by ${brandName()} in ${citiesLabel()}`}
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Towns served -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <div class="bg-white rounded-[20px] px-6 py-10 text-center md:px-10 md:py-14">
            <h2 class="text-gray-900 text-2xl font-bold mb-2 md:text-3xl">Proudly Serving {citiesLabel()}</h2>
            <p class="text-gray-500 text-sm mb-6">Illustrative coverage map — not to scale</p>
            <div class="relative mx-auto w-full max-w-[360px]">
              <svg viewBox="0 0 300 420" class="w-full h-auto" role="img" aria-label={`Map of ${brandName()} service area across ${citiesLabel()}`}>
                <polygon points={ayrshireOutline} fill="#ea580c" fill-opacity="0.12" stroke="#ea580c" stroke-width="3" stroke-linejoin="round" />
                {townMapPoints.map((town) => (
                  <g>
                    <title>{town.name}</title>
                    <circle cx={town.x} cy={town.y} r="6" fill="#ea580c" stroke="white" stroke-width="2" />
                    <text x={town.x} y={town.y - 11} text-anchor="middle" font-size="11" font-weight="700" fill="#374151">{town.name}</text>
                  </g>
                ))}
              </svg>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ accordion -->
      <section class="box-border caret-transparent py-[70px] md:py-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            Frequently Asked Questions
          </h2>
          <div class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-10">
            {roofService.faq.map((item) => (
              <FAQItem client:load question={item.question} answer={item.answer} />
            ))}
          </div>
        </div>
      </section>

      <!-- Quote form -->
      <section id="quote-form" class="box-border caret-transparent py-[70px] md:py-[110px]">
