---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdHeader } from "@/sections/Header/components/AdHeader";
import { ReviewStats } from "@/sections/ReviewsSection/components/ReviewStats";
import { ExperienceImage } from "@/sections/ExperienceSection/components/ExperienceImage";
import { ContactFormSection } from "@/pages/contact/sections/HeroSection/components/ContactFormSection";
import { FAQItem } from "@/pages/contact/sections/FAQSection/components/FAQItem";
import { getCategoryBySlug, getServicesForCategory } from "@/data/categories";
import { getServiceBySlug } from "@/data/services";
import { reviews } from "@/data/reviews";
import { locations } from "@/data/locations";
import { absoluteUrl, brandName, citiesLabel } from "@/data/business";

const category = getCategoryBySlug("roof-cleaning-ayrshire")!;
const includedServices = getServicesForCategory(category);
const roofService = getServiceBySlug("roof-cleaning-moss-removal")!;
const canonical = absoluteUrl("/ads/roof-cleaning-ayrshire");
const absoluteImage = absoluteUrl(category.image);
const roofGalleryImages = ["/gal_07.jpg", "/gal_08.jpg", "/gal_09.jpg", "/gal_10.jpg"];

const heroBenefitTicks = [
  "No Harsh Pressure Washing",
  "Fully Insured & Experienced",
  "Free, No-Obligation Quotes",
];

const whyChooseUsPoints = [
  {
    text: "Free, no-obligation quotes — no pressure, no obligation",
    icon: ["M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z", "M6 6h.008v.008H6V6z"],
  },
  {
    text: "Safe scrape-and-biocide method — no harsh pressure washing on tiles",
    icon: ["M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z", "M18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"],
  },
  {
    text: "Fully insured, experienced local team",
    icon: ["M9 12.75L11.25 15 15 9.75M21 12c0 4.556-3.04 8.4-7.2 9.6a1.06 1.06 0 01-.6 0C9.04 20.4 6 16.556 6 12V6.75a.75.75 0 01.55-.72l5.25-1.5a.75.75 0 01.4 0l5.25 1.5a.75.75 0 01.55.72V12z"],
  },
  {
    text: "Gutter clearing & fascia cleaning available on the same visit",
    icon: ["M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"],
  },
  {
    text: "Biocide treatment to help prevent moss and algae regrowth",
    icon: ["M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5m4.75-11.396a24.301 24.301 0 014.5 0M14.25 3.104v5.714c0 .597.237 1.17.659 1.591L19.8 15.3m-14.8-.8l-1.402 1.402c-1.232 1.232-.65 3.318 1.067 3.611A48.309 48.309 0 007.5 20l4.5 1 4.5-1a48.309 48.309 0 004.635-.487c1.718-.293 2.3-2.379 1.067-3.61L19.8 15.3M5 14.5l1.257-.31A9.065 9.065 0 0112 15a9.065 9.065 0 006.743-.81L19.8 15.3"],
  },
  {
    text: `Local specialist covering ${citiesLabel()} and surrounding towns`,
    icon: ["M15 10.5a3 3 0 11-6 0 3 3 0 016 0z", "M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"],
  },
];

const howItWorksSteps = [
  {
    step: "1",
    title: "Contact Us",
    description: "Call or message us with your roof cleaning needs. We'll answer your questions and get you booked in.",
    icon: ["M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"],
  },
  {
    step: "2",
    title: "Get Your Free Quote",
    description: "We assess your roof's condition and access, then provide a free, no-obligation quote — honest advice, no pushy sales.",
    icon: ["M9 14.25l6-6m4.5-3.493V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.757c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0c1.1.128 1.907 1.077 1.907 2.185zM9.75 9h.008v.008H9.75V9zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 4.5h.008v.008h-.008V13.5zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"],
  },
  {
    step: "3",
    title: "We Get To Work",
    description: "Safe manual moss removal, biocide treatment and gutter clearing — leaving your roof clean, treated and looking its best.",
    icon: ["M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z", "M18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z", "M16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"],
  },
];
---

<BaseLayout
  title={`Roof Cleaning & Moss Removal in ${citiesLabel()} | ${brandName()}`}
  description={category.description}
  canonical={canonical}
  ogImage={absoluteImage}
  robots="noindex, follow"
  stickyContactHref="#quote-form"
>
  <div class="text-neutral-600 text-lg not-italic normal-nums font-medium accent-auto bg-[#111111] box-border caret-transparent block tracking-[normal] leading-[27px] list-outside list-disc min-h-full pointer-events-auto text-start indent-[0px] normal-case visible border-separate font-manrope">
    <AdHeader client:load />
    <main>
      <!-- Hero -->
      <section class="box-border caret-transparent pt-[96px] md:pt-[120px]">
        <div class="relative bg-gray-900 bg-cover bg-center box-border caret-transparent mx-[15px] pt-[80px] pb-[90px] rounded-[20px] md:pt-[140px] md:pb-[170px] overflow-hidden" style={`background-image:url('${category.image}')`}>
          <div class="absolute inset-0 bg-gradient-to-b from-gray-900/60 via-gray-900/70 to-gray-900/90"></div>
          <div class="relative z-10 box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px] text-center">
            <p class="text-[#ea580c] text-sm font-semibold uppercase tracking-[0.18em] mb-4">Roof Cleaning</p>
            <h1 class="text-white text-[34px] font-bold box-border caret-transparent leading-[44px] mb-5 md:text-[60px] md:leading-[70px]">
              Roof Cleaning & Moss Removal in <span class="text-[#ea580c]">{citiesLabel()}</span>
            </h1>
            <p class="text-slate-200 box-border caret-transparent max-w-[640px] mx-auto mb-6">Over 10+ years of 5 star service</p>
            <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mb-8">
              {heroBenefitTicks.map((tick) => (
                <div class="flex items-center gap-2">
                  <div class="flex items-center justify-center w-5 h-5 rounded-full bg-[#ea580c] flex-shrink-0">
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span class="text-white text-sm md:text-base font-semibold">{tick}</span>
                </div>
              ))}
            </div>
            <div class="box-border caret-transparent flex flex-wrap items-center justify-center gap-4">
              <a href="#quote-form" class="text-white text-base bg-[#c2410c] box-border caret-transparent leading-[22px] text-center font-bold border border-[#c2410c] px-8 py-4 rounded-[50px] border-solid md:text-lg md:leading-[25.2px] md:px-[36px] md:py-5 hover:bg-[#ea580c] hover:border-[#ea580c] transition-colors inline-flex items-center justify-center gap-3">
                <svg class="h-5 w-5 md:h-6 md:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                Get a Free Quote
              </a>
            </div>
            <div class="flex justify-center mt-8">
              <ReviewStats client:load />
            </div>
          </div>
        </div>
      </section>

      <!-- Why choose us -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[140px]">
        <div class="box-border caret-transparent max-w-[1200px] mx-auto px-[15px] md:px-[30px]">
          <div class="box-border caret-transparent gap-x-[30px] grid auto-cols-[1fr] grid-cols-[1fr] grid-rows-[auto] gap-y-[30px] md:gap-x-[70px] md:grid-cols-[1fr_1fr] md:gap-y-[70px]">
            <ExperienceImage client:load images={roofGalleryImages} alt={`Roof cleaning and moss removal before and after by ${brandName()} in ${citiesLabel()}`} />
            <div class="box-border caret-transparent">
              <h2 class="text-white text-3xl font-bold box-border caret-transparent leading-[38px] mb-2.5 sm:text-4xl sm:leading-[43.2px] md:text-[56px] md:leading-[67.2px]">
                Why Choose {brandName()}?
              </h2>
              <p class="text-gray-200 text-sm sm:text-base box-border caret-transparent mt-2.5 mb-5 md:mt-5 md:mb-5 leading-relaxed">
                {brandName()} helps homeowners across {citiesLabel()} with safe roof cleaning, moss removal, gutter clearing and biocide treatment — reliable service and professional results, no harsh pressure washing on tiles.
              </p>
              <div class="box-border caret-transparent mb-5 md:mb-[50px]">
                <ul class="text-white text-sm sm:text-base md:text-lg box-border caret-transparent list-none pl-0 space-y-2 md:space-y-3">
                  {whyChooseUsPoints.map((point) => (
                    <li class="flex items-center gap-3">
                      <div class="flex items-center justify-center w-8 h-8 md:w-9 md:h-9 rounded-full bg-[#ea580c] flex-shrink-0">
                        <svg class="w-4 h-4 md:w-5 md:h-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          {point.icon.map((d) => (
                            <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                          ))}
                        </svg>
                      </div>
                      <span class="text-white font-medium">{point.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <a
                href="#quote-form"
                class="text-white text-sm bg-[#c2410c] box-border caret-transparent inline-block leading-[19.6px] text-center border border-[#c2410c] px-5 py-2 rounded-[50px] border-solid md:text-lg md:leading-[25.2px] md:px-[30px] md:py-3 hover:bg-[#ea580c] hover:decoration-transparent transition-colors duration-300"
              >
                Get a Free Quote
              </a>
              <div class="box-border caret-transparent mt-8 md:mt-10">
                <ReviewStats client:load />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            How Our Roof Cleaning Works
          </h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {howItWorksSteps.map((item) => (
              <div class="bg-white rounded-[20px] p-6 text-center">
                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#ea580c]">
                  <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    {item.icon.map((d) => (
                      <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                    ))}
                  </svg>
                </div>
                <p class="text-[#ea580c] text-xs font-bold uppercase tracking-wide mb-1">Step {item.step}</p>
                <h3 class="text-gray-900 text-lg font-bold mb-2">{item.title}</h3>
                <p class="text-gray-700 text-sm">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Trust banner -->
      <section class="box-border caret-transparent pt-[60px] md:pt-[90px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <div class="bg-[#ea580c] rounded-[20px] py-5 px-6 text-center">
            <p class="text-white text-lg md:text-xl font-bold">100% Satisfaction &middot; Fully Insured &middot; Free Quotes</p>
          </div>
        </div>
      </section>

      <!-- Testimonials -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            What {citiesLabel()} Homeowners Say
          </h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {reviews.map((review) => (
              <div class="bg-white rounded-[20px] p-6">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center gap-3">
                    <div class={`flex h-9 w-9 items-center justify-center rounded-full text-white font-bold ${review.initialBg}`}>
                      {review.initial}
                    </div>
                    <div>
                      <p class="text-gray-900 font-bold text-sm">{review.name}</p>
                      <p class="text-gray-500 text-xs">{review.meta}</p>
                    </div>
                  </div>
                  <div class="flex flex-col items-end gap-1">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-label="Google review">
                      <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                      <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                      <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                      <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    <div class="flex items-center gap-0.5">
                      {[...Array(5)].map(() => (
                        <svg class="h-3.5 w-3.5 text-[#ea580c]" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                  </div>
                </div>
                <p class="text-gray-700 text-sm leading-6">{review.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- What's included -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            What's Included
          </h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {includedServices.map((service) => (
              <div class="rounded-xl bg-neutral-900/75 border border-white/10 p-6 text-center">
                <img src={service.iconUrl} alt={service.iconAlt} class="mx-auto mb-4 h-10 w-10" />
                <h3 class="text-white text-lg font-bold mb-2">{service.shortTitle}</h3>
                <p class="text-slate-300 text-sm">{service.cardDescription}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Towns served -->
      <section class="box-border caret-transparent pt-[70px] md:pt-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <div class="relative overflow-hidden rounded-[20px]">
            <img src="/gal_08.jpg" alt={`${brandName()} service area across ${citiesLabel()}`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-[#111111]/80"></div>
            <div class="relative z-10 px-6 py-10 text-center md:py-14">
              <h2 class="text-white text-2xl font-bold mb-6 md:text-3xl">Proudly Serving {citiesLabel()}</h2>
              <p class="text-white text-base md:text-lg leading-8">
                {locations.map((location, index) => (
                  <>
                    {index > 0 && " · "}
                    <span class="font-semibold">{location.name}</span>
                  </>
                ))}
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ accordion -->
      <section class="box-border caret-transparent py-[70px] md:py-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            Frequently Asked Questions
          </h2>
          <div class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-10">
            {roofService.faq.map((item) => (
              <FAQItem client:load question={item.question} answer={item.answer} />
            ))}
          </div>
        </div>
      </section>

      <!-- Quote form -->
      <section id="quote-form" class="box-border caret-transparent py-[70px] md:py-[110px]">
        <div class="box-border caret-transparent max-w-[900px] mx-auto px-[15px] md:px-[30px]">
          <h2 class="text-white text-2xl font-bold box-border caret-transparent leading-[30px] mb-8 text-center md:text-4xl md:leading-[43.2px]">
            Get Your Free Roof Cleaning Quote
          </h2>
          <ContactFormSection client:load />
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
